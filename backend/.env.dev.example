# TICKBRON backend settings for YOUR OWN computer (also when you share it through ngrok, see .ai/LOCAL_NGROK.md).
# Copy this file to backend/.env. Nothing here is commented out, so it works as it is.
# NEVER use this file on a server: DEBUG is on and the secret is public. For a server use backend/.env.example.

# Django
SECRET_KEY=dev-only-secret-key-never-use-this-on-a-server
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
BUSINESS_TIME_ZONE=Asia/Tashkent

# Database: a local PostgreSQL (create the user and the database once, see backend/CLAUDE.md)
DB_NAME=tickbron
DB_USER=tickbron_user
DB_PASSWORD=tickbron_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_NETWORK_IS_PRIVATE=False

# Redis, cache and background tasks. With CELERY_TASK_ALWAYS_EAGER=True no Celery worker is needed:
# mails and alerts run inside the request.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
USE_REDIS_CACHE=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
EXPIRED_BOOKINGS_INTERVAL_SECONDS=60

# Browser security. The site and the API share one address (the Vite dev server forwards /api and /media to the
# backend), so the page's own address must be trusted for forms: put your ngrok address in place of the example
# (the part after https://, exactly as ngrok shows it) and keep the two local ones.
NUM_PROXIES=0
USE_X_FORWARDED_PROTO=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-name.ngrok-free.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_AGE=604800

# Rate limits, raised: everybody who opens the site through one ngrok address looks like one visitor to the backend
THROTTLE_ANON_RATE=20000/hour
THROTTLE_USER_RATE=10000/hour
THROTTLE_BOOKING_CREATE_RATE=300/hour
THROTTLE_NO_SHOW_REPORT_RATE=200/hour
THROTTLE_CHAT_SEND_RATE=200/min
THROTTLE_CHAT_POLL_RATE=900/min

# Exchange rates from the Central Bank of Uzbekistan (the default values)
FX_STALE_AFTER_DAYS=3
FX_MAX_CHANGE=0.10
FX_MIN_RATE=1000
FX_MAX_RATE=100000
FX_FETCH_TIMEOUT=10

# Bookings, no-shows, statistics (the default values)
ARRIVAL_GRACE_HOURS=2
RATE_PLAN_PRICES_REQUIRED=true
NO_SHOW_REPORT_WINDOW_DAYS=7
NO_SHOW_FLAG_DAYS=90
NO_SHOW_FLAG_MIN_REPORTS=5
NO_SHOW_FLAG_FACTOR=3
NO_SHOW_FLAG_MIN_RATE=0.10
CSV_EXPORT_MAX_ROWS=10000

# E-mail: with DEBUG on the mails (password reset, booking notices) are printed in the server console, so these
# stay empty. FRONTEND_URL is the address in the links of those mails: use your ngrok address when you share the site.
FRONTEND_URL=http://localhost:3000
SUPPORT_NOTIFY_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TICKBRON <no-reply@tickbron.com>

# Telegram alerts (empty = off)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

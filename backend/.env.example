# TICKBRON backend settings. Copy this file to backend/.env and change the values.
# Lines starting with "# NAME=value" are optional: the value shown is the default.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# With DEBUG=False the app refuses to start unless: SECRET_KEY is random and 50+ characters,
# ALLOWED_HOSTS lists real hosts, CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS are https:// only,
# and PAYMENT_TEST_MODE is False (see config/settings.py, end of file).
SECRET_KEY=your-secret-key-here-change-in-production
# Local development only: set DEBUG=True in your own .env (never on a server)
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Log level of the app logger. Default: INFO when DEBUG=True, WARNING otherwise.
# LOG_LEVEL=WARNING
# The date "today" for bookings, statistics and auto-completion (an IANA time zone name)
# BUSINESS_TIME_ZONE=Asia/Tashkent

# ---------------------------------------------------------------------------
# Database (PostgreSQL only; SQLite is not supported)
# ---------------------------------------------------------------------------
DB_NAME=tickbron
DB_USER=tickbron_user
DB_PASSWORD=tickbron_password
DB_HOST=localhost
DB_PORT=5432
# A remote database (any DB_HOST except localhost) must use require, verify-ca or verify-full
# DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Redis, cache, Celery
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0   # overrides REDIS_HOST/PORT/DB
# Cache backend: Redis (shared by all workers) or per-process LocMem. Defaults to Redis when DEBUG=False.
# USE_REDIS_CACHE=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Local development without a Celery worker: run background tasks (mail, alerts) inside the request
CELERY_TASK_ALWAYS_EAGER=False
# How often (seconds) Celery beat expires unpaid pending bookings
# EXPIRED_BOOKINGS_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Reverse proxy, cookies, browser security
# ---------------------------------------------------------------------------
# Reverse proxies in front of the app that append to X-Forwarded-For (0 = ignore the header)
# Production: must be set (0 = no reverse proxy, 1 = one nginx in front). See .ai/RELEASE_CHECKLIST.md
NUM_PROXIES=0
# Production behind a TLS-terminating proxy: True (nginx must overwrite X-Forwarded-Proto)
USE_X_FORWARDED_PROTO=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=False
# Session/CSRF cookies are https-only by default when DEBUG=False and plain http when DEBUG=True.
# Set these only to override that; never set False in production.
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# How long a login session lasts, in seconds (default: one week)
# SESSION_COOKIE_AGE=604800
# HSTS: seconds, subdomains, preload. Preload is hard to undo (browsers ship the list): owner decision.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# SECURE_CONTENT_TYPE_NOSNIFF=True
# X_FRAME_OPTIONS=DENY

# ---------------------------------------------------------------------------
# Rate limits (login, register and password reset have their own stricter limits in code)
# ---------------------------------------------------------------------------
# THROTTLE_ANON_RATE=2000/hour
# THROTTLE_USER_RATE=1000/hour
# THROTTLE_BOOKING_CREATE_RATE=30/hour
# THROTTLE_NO_SHOW_REPORT_RATE=20/hour
# THROTTLE_WEBHOOK_RATE=600/min

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Keep False outside local development: True lets the client confirm payments itself via /confirm/ when DEBUG=True.
PAYMENT_TEST_MODE=False
# Provider credentials (placeholders for production)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_ID=
VISA_API_KEY=
VISA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Exchange rates (Central Bank of Uzbekistan, see currency/cbu.py)
# ---------------------------------------------------------------------------
# A rate older than this many days is stale
# FX_STALE_AFTER_DAYS=3
# A new rate that differs from the saved one by more than this fraction is rejected
# FX_MAX_CHANGE=0.10
# Plausible range of UZS per USD; anything outside is rejected
# FX_MIN_RATE=1000
# FX_MAX_RATE=100000
# Seconds to wait for the Central Bank
# FX_FETCH_TIMEOUT=10

# ---------------------------------------------------------------------------
# No-shows and statistics
# ---------------------------------------------------------------------------
# Share of the paid amount refunded when a hotel reports a no-show, a whole number 0-100.
# Every booking stores the value it was created with; changing this never changes old bookings.
# NO_SHOW_REFUND_PERCENT=50
# Hotels may report a no-show up to this many days after check-out
# NO_SHOW_REPORT_WINDOW_DAYS=7
# A hotel is flagged when, over the last NO_SHOW_FLAG_DAYS days, it has at least NO_SHOW_FLAG_MIN_REPORTS
# reports, its report rate is NO_SHOW_FLAG_FACTOR times the platform rate and at least NO_SHOW_FLAG_MIN_RATE
# NO_SHOW_FLAG_DAYS=90
# NO_SHOW_FLAG_MIN_REPORTS=5
# NO_SHOW_FLAG_FACTOR=3
# NO_SHOW_FLAG_MIN_RATE=0.10
# CSV exports in the Status sections stop after this many rows
# CSV_EXPORT_MAX_ROWS=10000

# ---------------------------------------------------------------------------
# E-mail (password reset links)
# ---------------------------------------------------------------------------
# With DEBUG=True the mail is printed in the server console; with DEBUG=False it is sent through SMTP.
# In production EMAIL_HOST and an https FRONTEND_URL are required (the app refuses to start without them).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
FRONTEND_URL=http://localhost:3000
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TICKBRON <no-reply@tickbron.uz>

# ---------------------------------------------------------------------------
# Telegram alerts for security events and errors (empty = off)
# ---------------------------------------------------------------------------
# Bot from @BotFather, chat id of the alert chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

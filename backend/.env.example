# TICKBRON backend settings for a SERVER. Copy this file to backend/.env and change the values.
# For your own computer (also through ngrok) use backend/.env.dev.example instead: it works as it is.
# Every line below is active. Most values are the defaults; SECRET_KEY, DB_*, ALLOWED_HOSTS, the origins, FRONTEND_URL,
# the e-mail and Telegram lines are yours to change. The few lines that stay
# commented ("# NAME=value") are left out on purpose: their default depends on DEBUG, so a fixed value could be
# wrong on a server. Set them only when you know you need them.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# With DEBUG=False the app refuses to start unless: SECRET_KEY is random and 50+ characters,
# ALLOWED_HOSTS lists real hosts, and CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS are https:// only
# (see config/settings.py, end of file).
SECRET_KEY=your-secret-key-here-change-in-production
# Seals the authenticator secrets of administrators in the database (two-step sign-in). Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it with the backups of the database, but apart from them: losing it locks every administrator out of the
# second step (the server command `python manage.py reset_2fa <email>` still lets a super admin in); a leaked database alone cannot be used without it.
TWO_FACTOR_KEY=CHANGE_ME_fernet_key
# True makes two-step sign-in a must for administrators and staff (needs TWO_FACTOR_KEY); it is the default when
# DEBUG is False. On your own computer (DEBUG=True) it is off unless you set it.
TWO_FACTOR_REQUIRED_FOR_ADMINS=True
# Local development only: set DEBUG=True in your own .env (never on a server)
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Log level of the app logger. Default: INFO when DEBUG=True, WARNING otherwise.
# LOG_LEVEL=WARNING
# The date "today" for bookings, statistics and auto-completion (an IANA time zone name)
BUSINESS_TIME_ZONE=Asia/Tashkent

# ---------------------------------------------------------------------------
# Database (PostgreSQL only; SQLite is not supported)
# ---------------------------------------------------------------------------
DB_NAME=tickbron
DB_USER=tickbron_user
DB_PASSWORD=tickbron_password
DB_HOST=localhost
DB_PORT=5432
# A remote database (any DB_HOST except localhost) must use require, verify-ca or verify-full
DB_SSLMODE=prefer
# Docker setup only (docker-compose.yml): the database is the container `db` on Docker's private network, not a
# remote server. True lets a bare service name (no dot, no IP) skip the TLS rule above; leave it out otherwise
DB_NETWORK_IS_PRIVATE=False

# ---------------------------------------------------------------------------
# Redis, cache, Celery
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0   # overrides REDIS_HOST/PORT/DB
# Cache backend: Redis (shared by all workers) or per-process LocMem. Defaults to Redis when DEBUG=False.
# USE_REDIS_CACHE=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Local development without a Celery worker: run background tasks (mail, alerts) inside the request
CELERY_TASK_ALWAYS_EAGER=False
# How often (seconds) Celery beat expires unpaid pending bookings
EXPIRED_BOOKINGS_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Reverse proxy, cookies, browser security
# ---------------------------------------------------------------------------
# Reverse proxies in front of the app that append to X-Forwarded-For (0 = ignore the header)
# Production: must be set (0 = no reverse proxy, 1 = one nginx in front). See .ai/RELEASE_CHECKLIST.md
NUM_PROXIES=0
# Production behind a TLS-terminating proxy: True (nginx must overwrite X-Forwarded-Proto)
USE_X_FORWARDED_PROTO=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=False
# Session/CSRF cookies are https-only by default when DEBUG=False and plain http when DEBUG=True.
# Set these only to override that; never set False in production.
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# How long a login session lasts, in seconds (default: one week)
SESSION_COOKIE_AGE=604800
# HSTS: seconds, subdomains, preload. Preload is hard to undo (browsers ship the list): owner decision.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# ---------------------------------------------------------------------------
# Rate limits (login, register and password reset have their own stricter limits in code)
# ---------------------------------------------------------------------------
THROTTLE_ANON_RATE=2000/hour
# THROTTLE_SEARCH_RATE=100/min   (search endpoints, per address; raise it when many phones share one address)
THROTTLE_USER_RATE=1000/hour
THROTTLE_BOOKING_CREATE_RATE=30/hour
THROTTLE_NO_SHOW_REPORT_RATE=20/hour
THROTTLE_CHAT_SEND_RATE=20/min
THROTTLE_CHAT_POLL_RATE=90/min

# ---------------------------------------------------------------------------
# Exchange rates (Central Bank of Uzbekistan, see currency/cbu.py)
# ---------------------------------------------------------------------------
# A rate older than this many days is stale
FX_STALE_AFTER_DAYS=3
# A new rate that differs from the saved one by more than this fraction is rejected
FX_MAX_CHANGE=0.10
# Plausible range of UZS per USD; anything outside is rejected
FX_MIN_RATE=1000
FX_MAX_RATE=100000
# Seconds to wait for the Central Bank
FX_FETCH_TIMEOUT=10

# ---------------------------------------------------------------------------
# No-shows and statistics
# ---------------------------------------------------------------------------
# Hours the hotel waits after the guest's arrival time before the booking is cancelled
ARRIVAL_GRACE_HOURS=2

# R16: true (the default) = a rate plan must carry the owner's price in every currency (USD, UZS, KZT, RUB) on create
# and on every edit.
RATE_PLAN_PRICES_REQUIRED=true
# Hotels may report a no-show up to this many days after check-out
NO_SHOW_REPORT_WINDOW_DAYS=7
# A hotel is flagged when, over the last NO_SHOW_FLAG_DAYS days, it has at least NO_SHOW_FLAG_MIN_REPORTS
# reports, its report rate is NO_SHOW_FLAG_FACTOR times the platform rate and at least NO_SHOW_FLAG_MIN_RATE
NO_SHOW_FLAG_DAYS=90
NO_SHOW_FLAG_MIN_REPORTS=5
NO_SHOW_FLAG_FACTOR=3
NO_SHOW_FLAG_MIN_RATE=0.10
# CSV exports in the Status sections stop after this many rows
CSV_EXPORT_MAX_ROWS=10000

# ---------------------------------------------------------------------------
# E-mail (password reset links)
# ---------------------------------------------------------------------------
# With DEBUG=True the mail is printed in the server console; with DEBUG=False it is sent through SMTP.
# In production EMAIL_HOST and an https FRONTEND_URL are required (the app refuses to start without them).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
FRONTEND_URL=http://localhost:3000
# Where the team is mailed about a new support chat message (leave empty to turn it off)
SUPPORT_NOTIFY_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TICKBRON <no-reply@tickbron.com>

# ---------------------------------------------------------------------------
# Telegram alerts for security events and errors (empty = off)
# ---------------------------------------------------------------------------
# Bot from @BotFather, chat id of the alert chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ---------------------------------------------------------------------------
# Copies of public pages
# ---------------------------------------------------------------------------
# Seconds a copy of a public answer (hotel page, free rooms, search results) is kept in the cache so thousands of visitors
# do not each ask the database. A price or a free-room count on a list can be this old; booking always checks again.
# 0 turns it off. Needs the shared cache (USE_REDIS_CACHE=True) to be shared between the server processes.
PUBLIC_CACHE_SECONDS=30

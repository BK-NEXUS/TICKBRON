# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tickbron
DB_USER=tickbron_user
DB_PASSWORD=tickbron_password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0   # overrides REDIS_HOST/PORT/DB
# Cache backend: Redis (shared by all workers) or per-process LocMem. Defaults to Redis when DEBUG=False.
# USE_REDIS_CACHE=False
# Reverse proxies in front of the app that append to X-Forwarded-For (0 = ignore the header)
NUM_PROXIES=0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payment Configuration
PAYMENT_TEST_MODE=True

# Payment Provider Configuration (placeholders for production)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_ID=
VISA_API_KEY=
VISA_SECRET_KEY=

# SMS Configuration
SMS_TEST_MODE=True

# TICKBRON: texts the API shows in the page language. Edit, then run: python scripts/compile_po.py
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: uz\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# Django REST framework has no Uzbek catalog; these are its texts.

msgid "This field is required."
msgstr "Bu maydon to'ldirilishi shart."

msgid "This field may not be blank."
msgstr "Bu maydon bo'sh bo'lishi mumkin emas."

msgid "This field may not be null."
msgstr "Bu maydon qiymatsiz bo'lishi mumkin emas."

msgid "This field must be unique."
msgstr "Bu qiymat noyob bo'lishi kerak."

msgid "A valid integer is required."
msgstr "To'g'ri butun son kiriting."

msgid "A valid number is required."
msgstr "To'g'ri son kiriting."

msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Qiymat {min_value} dan kam bo'lmasligi kerak."

msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Qiymat {max_value} dan oshmasligi kerak."

msgid "Ensure this field has at least {min_length} characters."
msgstr "Bu maydonda kamida {min_length} ta belgi bo'lishi kerak."

msgid "Ensure this field has no more than {max_length} characters."
msgstr "Bu maydonda {max_length} tadan ortiq belgi bo'lmasligi kerak."

msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Jami {max_digits} tadan ortiq raqam bo'lmasligi kerak."

msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr "Kasr qismida {max_decimal_places} tadan ortiq raqam bo'lmasligi kerak."

msgid "Ensure that there are no more than {max_whole_digits} digits before the decimal point."
msgstr "Kasr belgisidan oldin {max_whole_digits} tadan ortiq raqam bo'lmasligi kerak."

msgid "\"{input}\" is not a valid choice."
msgstr "\"{input}\" to'g'ri tanlov emas."

msgid "Enter a valid email address."
msgstr "To'g'ri elektron pochta manzilini kiriting."

msgid "Enter a valid URL."
msgstr "To'g'ri havolani (URL) kiriting."

msgid "Enter a valid \"slug\" consisting of letters, numbers, underscores or hyphens."
msgstr "Faqat harf, raqam, pastki chiziq yoki defisdan iborat to'g'ri \"slug\" kiriting."

msgid "Enter a valid IPv4 or IPv6 address."
msgstr "To'g'ri IPv4 yoki IPv6 manzilini kiriting."

msgid "Date has wrong format. Use one of these formats instead: {format}."
msgstr "Sana formati noto'g'ri. Quyidagi formatlardan birini ishlating: {format}."

msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr "Sana va vaqt formati noto'g'ri. Quyidagi formatlardan birini ishlating: {format}."

msgid "Time has wrong format. Use one of these formats instead: {format}."
msgstr "Vaqt formati noto'g'ri. Quyidagi formatlardan birini ishlating: {format}."

msgid "Duration has wrong format. Use one of these formats instead: {format}."
msgstr "Davomiylik formati noto'g'ri. Quyidagi formatlardan birini ishlating: {format}."

msgid "Expected a date but got a datetime."
msgstr "Sana kutilgan edi, sana va vaqt keldi."

msgid "Expected a datetime but got a date."
msgstr "Sana va vaqt kutilgan edi, sana keldi."

msgid "This list may not be empty."
msgstr "Ro'yxat bo'sh bo'lishi mumkin emas."

msgid "This selection may not be empty."
msgstr "Tanlov bo'sh bo'lishi mumkin emas."

msgid "No items to select."
msgstr "Tanlash uchun elementlar yo'q."

msgid "Expected a list of items but got type \"{input_type}\"."
msgstr "Elementlar ro'yxati kutilgan edi, \"{input_type}\" turi keldi."

msgid "Expected a dictionary of items but got type \"{input_type}\"."
msgstr "Obyekt kutilgan edi, \"{input_type}\" turi keldi."

msgid "Invalid data. Expected a dictionary, but got {datatype}."
msgstr "Noto'g'ri ma'lumot. Obyekt kutilgan edi, {datatype} keldi."

msgid "Invalid pk \"{pk_value}\" - object does not exist."
msgstr "Noto'g'ri \"{pk_value}\" identifikatori: bunday obyekt yo'q."

msgid "Incorrect type. Expected pk value, received {data_type}."
msgstr "Noto'g'ri tur. Identifikator kutilgan edi, {data_type} keldi."

msgid "Incorrect type. Expected URL string, received {data_type}."
msgstr "Noto'g'ri tur. Havola kutilgan edi, {data_type} keldi."

msgid "No file was submitted."
msgstr "Fayl yuborilmadi."

msgid "The submitted data was not a file. Check the encoding type on the form."
msgstr "Yuborilgan ma'lumot fayl emas. Formaning kodlash turini tekshiring."

msgid "No filename could be determined."
msgstr "Fayl nomini aniqlab bo'lmadi."

msgid "The submitted file is empty."
msgstr "Yuborilgan fayl bo'sh."

msgid "Ensure this filename has at most {max_length} characters (it has {length})."
msgstr "Fayl nomi {max_length} tadan ortiq belgidan iborat bo'lmasligi kerak (hozir {length} ta)."

msgid "Upload a valid image. The file you uploaded was either not an image or a corrupted image."
msgstr "To'g'ri rasm yuklang. Yuklangan fayl rasm emas yoki buzilgan."

msgid "Invalid page."
msgstr "Sahifa noto'g'ri."

msgid "Invalid value."
msgstr "Qiymat noto'g'ri."

msgid "Value must be valid JSON."
msgstr "Qiymat to'g'ri JSON bo'lishi kerak."

msgid "This value does not match the required pattern."
msgstr "Qiymat talab qilingan shablonga mos kelmaydi."

msgid "The fields {field_names} must make a unique set."
msgstr "{field_names} maydonlari birgalikda noyob bo'lishi kerak."

msgid "String value too large."
msgstr "Matn juda uzun."

msgid "Not found."
msgstr "Topilmadi."

msgid "You do not have permission to perform this action."
msgstr "Bu amalni bajarishga ruxsatingiz yo'q."

msgid "Authentication credentials were not provided."
msgstr "Kirish ma'lumotlari yuborilmadi."

msgid "Incorrect authentication credentials."
msgstr "Kirish ma'lumotlari noto'g'ri."

msgid "Request was throttled."
msgstr "So'rovlar soni cheklandi."

msgid "Method \"{method}\" not allowed."
msgstr "\"{method}\" usuli ruxsat etilmagan."

msgid "Unsupported media type \"{media_type}\" in request."
msgstr "So'rovdagi \"{media_type}\" media turi qo'llab-quvvatlanmaydi."

msgid "Malformed request."
msgstr "So'rov noto'g'ri tuzilgan."

msgid "A server error occurred."
msgstr "Serverda xatolik yuz berdi."

# Messages written in this project.

msgid "UZS prices must be whole so'm."
msgstr "UZS narxlari butun so'mda bo'lishi kerak."

msgid "Currency must be one of: %(codes)s."
msgstr "Valyuta quyidagilardan biri bo'lishi kerak: %(codes)s."

msgid "The currency cannot change after room types exist; their prices use it."
msgstr "Xona turlari yaratilgandan keyin valyutani o'zgartirib bo'lmaydi: ularning narxlari shu valyutada."

msgid "Must be the property currency (%(currency)s)."
msgstr "Mehmonxona valyutasi bo'lishi kerak (%(currency)s)."

msgid "Your hotels are placed by the administrator and cannot be moved."
msgstr "Mehmonxonalaringiz joyini administrator belgilaydi, uni o'zgartirib bo'lmaydi."

msgid "Send an object like {{\"en\": {{\"name\": \"Hotel\", \"description\": \"...\"}}}}."
msgstr "Quyidagi ko'rinishdagi obyekt yuboring: {{\"en\": {{\"name\": \"Hotel\", \"description\": \"...\"}}}}."

msgid "Give the hotel a name in at least one language."
msgstr "Mehmonxonaga kamida bitta tilda nom bering."

msgid "Unsupported language. Use: %(languages)s."
msgstr "Til qo'llab-quvvatlanmaydi. Ishlating: %(languages)s."

msgid "Send {\"name\": \"...\", \"description\": \"...\"}."
msgstr "Quyidagicha yuboring: {\"name\": \"...\", \"description\": \"...\"}."

msgid "Cannot be less than the usual number of guests."
msgstr "Odatdagi mehmonlar sonidan kam bo'lishi mumkin emas."

msgid "You can only manage room types for your own properties."
msgstr "Faqat o'z mehmonxonalaringiz uchun xona turlarini boshqarishingiz mumkin."

msgid "Send an object like {{\"USD\": \"65.00\", \"UZS\": \"800000\"}}."
msgstr "Quyidagi ko'rinishdagi obyekt yuboring: {{\"USD\": \"65.00\", \"UZS\": \"800000\"}}."

msgid "Unsupported currency. Use: %(codes)s."
msgstr "Valyuta qo'llab-quvvatlanmaydi. Ishlating: %(codes)s."

msgid "Enter a number."
msgstr "Son kiriting."

msgid "Enter a price of zero or more."
msgstr "Nol yoki undan katta narx kiriting."

msgid "Too many decimals for this currency."
msgstr "Bu valyuta uchun kasr qismida raqamlar ortiqcha."

msgid "Whole amounts only."
msgstr "Faqat butun summalar."

msgid "You can only manage rate plans for your own properties."
msgstr "Faqat o'z mehmonxonalaringiz uchun tariflarni boshqarishingiz mumkin."

msgid "Enter the price in: %(codes)s."
msgstr "Narxni quyidagi valyutalarda kiriting: %(codes)s."

msgid "Must equal the price in %(currency)s (%(amount)s)."
msgstr "%(currency)s dagi narxga teng bo'lishi kerak (%(amount)s)."

msgid "Cannot be less than the minimum nights."
msgstr "Eng ko'p kecha soni eng kam kecha sonidan kam bo'lishi mumkin emas."

msgid "Enter the price in every currency before saving: %(codes)s."
msgstr "Saqlashdan oldin narxni har bir valyutada kiriting: %(codes)s."

msgid "You can only manage inventory for your own properties."
msgstr "Faqat o'z mehmonxonalaringiz uchun mavjudlikni boshqarishingiz mumkin."

msgid "The date cannot be in the past."
msgstr "Sana o'tmishda bo'lishi mumkin emas."

msgid "Cannot be more than the %(count)s rooms of this room type."
msgstr "Bu xona turidagi %(count)s ta xonadan ko'p bo'lishi mumkin emas."

msgid "Cannot be less than the minimum stay."
msgstr "Eng kam turish muddatidan kam bo'lishi mumkin emas."

msgid "You can only manage room inventory for your own properties."
msgstr "Faqat o'z mehmonxonalaringiz uchun xona mavjudligini boshqarishingiz mumkin."

msgid "You can only block room inventory for your own properties."
msgstr "Faqat o'z mehmonxonalaringiz xonalarini to'sib qo'yishingiz mumkin."

msgid "Make another photo the cover instead."
msgstr "Buning o'rniga boshqa rasmni muqova qiling."

msgid "You can only manage photos for your own properties."
msgstr "Faqat o'z mehmonxonalaringiz rasmlarini boshqarishingiz mumkin."

msgid "Names can contain letters, spaces, hyphens, dots and apostrophes only."
msgstr "Ismda faqat harflar, bo'sh joy, defis, nuqta va apostrof bo'lishi mumkin."

msgid "Use plain text without < or >."
msgstr "< va > belgilarisiz oddiy matn ishlating."

msgid "Remove the control characters."
msgstr "Boshqaruv belgilarini olib tashlang."

msgid "File size exceeds maximum allowed size of %(size)sMB"
msgstr "Fayl hajmi ruxsat etilgan %(size)s MB dan oshib ketdi"

msgid "File type %(ext)s is not allowed. Allowed types: %(types)s"
msgstr "%(ext)s turidagi fayl ruxsat etilmagan. Ruxsat etilgan turlar: %(types)s"

msgid "File content type %(type)s is not a valid image"
msgstr "Fayl turi %(type)s to'g'ri rasm emas"

msgid "Image dimensions are too large."
msgstr "Rasm o'lchamlari juda katta."

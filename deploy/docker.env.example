# Settings of the Docker setup. Copy this file to `.env` next to docker-compose.yml and fill it in:
#   cp deploy/docker.env.example .env
# `.env` holds secrets: it is NEVER put in git (it is in .gitignore) and never sent to anyone.
# Every value marked CHANGE_ME must be replaced. Lines starting with # are comments.

# --- The site -------------------------------------------------------------------------------------
# The domain without https:// and without www (the site must already open this name: DNS A record)
DOMAIN=tickbron.com
# An address of the owner: Let's Encrypt writes to it before a certificate expires
ACME_EMAIL=CHANGE_ME_owner_email

# --- The app (see deploy/env.production.example for what each setting does) -------------------------
# A long random text (50+ characters). Make one with: docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=CHANGE_ME_random_50_plus_characters
# Seals the authenticator secrets of administrators in the database (two-step sign-in). Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it with the backups of the database, but apart from them: losing it locks every administrator out of the
# second step (the server command `python manage.py reset_2fa <email>` still lets a super admin in); a leaked database alone cannot be used without it.
TWO_FACTOR_KEY=CHANGE_ME_fernet_key
DEBUG=False
ALLOWED_HOSTS=tickbron.com
BUSINESS_TIME_ZONE=Asia/Tashkent
LOG_LEVEL=WARNING
FRONTEND_URL=https://tickbron.com
CORS_ALLOWED_ORIGINS=https://tickbron.com
CSRF_TRUSTED_ORIGINS=https://tickbron.com
# Caddy is the one proxy in front of the app
NUM_PROXIES=1
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
ARRIVAL_GRACE_HOURS=2
RATE_PLAN_PRICES_REQUIRED=true

# --- Size of the web server (see .ai/LOAD_TEST.md) ---------------------------------------------------
# Processes (about one per CPU core) and the requests each handles at once. Every thread keeps a database connection,
# so WEB_WORKERS x WEB_THREADS must stay well under PostgreSQL's max_connections (100).
WEB_WORKERS=3
WEB_THREADS=4
WEB_TIMEOUT=30
# Seconds an idle connection from Caddy stays open: keep it above Caddy's own 2 minutes
WEB_KEEPALIVE=125

# --- Database (the db container; the name `db` is the container, do not change DB_HOST) ------------
DB_NAME=tickbron
DB_USER=tickbron_user
DB_PASSWORD=CHANGE_ME_database_password
DB_HOST=db
# The database is the container on Docker's private network (not a remote server): lets the app start without TLS to it
DB_NETWORK_IS_PRIVATE=True
DB_PORT=5432

# --- Redis (the redis container) -------------------------------------------------------------------
USE_REDIS_CACHE=True
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- E-mail (any SMTP service: the provider tells you these) ----------------------------------------
EMAIL_HOST=CHANGE_ME_smtp_host
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_smtp_user
EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TICKBRON <no-reply@tickbron.com>
# Where the support chat tells the team about new messages (an e-mail address), optional
SUPPORT_NOTIFY_EMAIL=

# --- Telegram alerts (optional: leave empty to switch off) -----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- Map pictures (optional) ------------------------------------------------------------------------
# Satellite pictures: empty = Esri World Imagery (light use only). See .ai/RELEASE_CHECKLIST.md before real traffic.
VITE_SATELLITE_TILE_URL=
VITE_SATELLITE_ATTRIBUTION=

# --- Ports (only to run the setup on a computer where 80 and 443 are taken; on the server leave out) --
# HTTP_PORT=80
# HTTPS_PORT=443

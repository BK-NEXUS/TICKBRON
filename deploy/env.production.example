# TICKBRON production settings for https://tickbron.com (one host: the site at /, the API at /api/, photos at /media/).
# On the server copy this file to backend/.env and replace every CHANGE_ME value. Never commit the real file.
# Lines are explained in backend/.env.example; the app refuses to start when a production rule is broken
# (see config/settings.py, end of file, and .ai/RELEASE_CHECKLIST.md "Production settings").

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Random value of 50+ characters:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_random_50_plus_characters
DEBUG=False
ALLOWED_HOSTS=tickbron.com
BUSINESS_TIME_ZONE=Asia/Tashkent
LOG_LEVEL=WARNING

# ---------------------------------------------------------------------------
# Domain, https, cookies (nginx in front: deploy/nginx.conf.example)
# ---------------------------------------------------------------------------
# The site and the API share one origin, so these are the same address. The www name is redirected to
# tickbron.com by nginx before it reaches Django.
FRONTEND_URL=https://tickbron.com
CORS_ALLOWED_ORIGINS=https://tickbron.com
CSRF_TRUSTED_ORIGINS=https://tickbron.com
# One nginx in front that appends to X-Forwarded-For and overwrites X-Forwarded-Proto
NUM_PROXIES=1
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Preload is hard to undo: only after the owner submits tickbron.com to hstspreload.org
SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# Database (PostgreSQL on the same server; a remote database needs DB_SSLMODE=require)
# ---------------------------------------------------------------------------
DB_NAME=tickbron
DB_USER=tickbron_user
DB_PASSWORD=CHANGE_ME_database_password
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis, cache, Celery (worker AND beat must run: arrival check every 10 min, exchange rates at 09:00 and 18:00)
# ---------------------------------------------------------------------------
USE_REDIS_CACHE=True
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ---------------------------------------------------------------------------
# E-mail (password reset links). Ask the mail provider of tickbron.com for the SMTP values.
# ---------------------------------------------------------------------------
EMAIL_HOST=CHANGE_ME_smtp_host
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_smtp_user
EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TICKBRON <no-reply@tickbron.com>

# ---------------------------------------------------------------------------
# Telegram alerts for security events and errors (empty = off)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ---------------------------------------------------------------------------
# Business rules (defaults shown; change only on purpose)
# ---------------------------------------------------------------------------
ARRIVAL_GRACE_HOURS=2
RATE_PLAN_PRICES_REQUIRED=true

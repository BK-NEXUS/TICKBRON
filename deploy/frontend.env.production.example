# TICKBRON frontend build settings for https://tickbron.com. Copy this file to frontend/.env.production
# before `npm run build`. Only VITE_ variables reach the browser: never put a secret here.
#
# The address of the backend, the server only (the code adds /api/v1/... itself). The site and the API
# share the host tickbron.com, and it must be written out: an empty value falls back to localhost.
VITE_API_BASE_URL=https://tickbron.com

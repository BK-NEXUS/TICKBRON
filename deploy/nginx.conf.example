# Reference nginx configuration for TICKBRON (one host serves the SPA, /api/ and /media/).
# Copy, check the paths, then test with `nginx -t`. See .ai/RELEASE_CHECKLIST.md.
# The Django app must run with NUM_PROXIES=1 and USE_X_FORWARDED_PROTO=True behind this file.

server {
    listen 80;
    server_name tickbron.com www.tickbron.com;
    return 301 https://tickbron.com$request_uri;
}

# www goes to the bare name (Django only knows tickbron.com)
server {
    listen 443 ssl;
    http2 on;
    server_name www.tickbron.com;
    # ssl_certificate / ssl_certificate_key: the same certificate, it must cover www.tickbron.com too
    return 301 https://tickbron.com$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name tickbron.com;

    # ssl_certificate / ssl_certificate_key: managed by your certificate tool

    server_tokens off;
    client_max_body_size 1m;   # JSON API; the photo upload location below raises it

    # Headers for every response, SPA and media included. `always` keeps them on error pages too.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # The SPA (static build of frontend/). The map tile host is in img-src (frontend/src/deployCsp.test.ts
    # keeps it in step with mapTiles.ts); add payment provider hosts if online payments are ever added.
    location / {
        root /var/www/tickbron/frontend/dist;
        try_files $uri /index.html;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://server.arcgisonline.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # API: overwrite (never append to) what the client sent, so the client address cannot be spoofed.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Photo upload: 10 MB image plus form overhead (Django also refuses bodies over 12 MB)
    location ~ ^/api/v1/partner/properties/[0-9]+/photos/ {
        client_max_body_size 12m;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Uploaded photos: images only, never executed or sniffed, no listing.
    location /media/ {
        alias /var/www/tickbron/media/;
        autoindex off;
        types { image/jpeg jpg jpeg; image/png png; image/gif gif; image/webp webp; }
        default_type application/octet-stream;
        add_header Content-Disposition "inline" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
}

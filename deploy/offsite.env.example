# The copy of the nightly backup outside the server (used by deploy/backup.sh and deploy/verify_backup.sh).
# Copy to deploy/offsite.env (it is not in git; only the owner may read it: chmod 600) and fill in. Plain KEY=value lines,
# no spaces around "=", no quotes. Needs `restic` on the server (apt install restic).
#
# Where the encrypted copies go: an S3 bucket in ANOTHER region than the server (private bucket, versioning on).
# First time only, create the repository:   set -a; . deploy/offsite.env; set +a; restic init
RESTIC_REPOSITORY=s3:s3.eu-west-1.amazonaws.com/CHANGE-ME-bucket-name
# The password that encrypts the copies. KEEP IT IN TWO PLACES (password manager and on paper): without it nobody can restore.
RESTIC_PASSWORD=
# An AWS user that may only write to this bucket (it must not be able to delete it)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# How long copies are kept: the last N days, then one a week, then one a month
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6

# A failed night is reported to this Telegram chat (the same bot as in .env; leave empty to switch it off)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

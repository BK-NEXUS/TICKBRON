# TICKBRON frontend settings. Copy this file to frontend/.env.local and change the values.
# Only variables that start with VITE_ reach the browser, so never put a secret in this file.

# Address of the backend: the server only. The code adds /api/v1/... itself
# (with /api/v1 here every request would go to /api/v1/api/v1/... and fail with 404).
# Production: the https:// address of the API, for example https://tickbron.com (the site and /api/ share one host)
VITE_API_BASE_URL=http://localhost:8000

# Satellite pictures of the map (optional). Default: Esri World Imagery, free for light use only.
# Before real traffic set a provider with a key; its host must also be in the CSP img-src of the web server.
# URL with {z}, {x}, {y}; the credit text the provider requires goes in the attribution (HTML allowed).
# VITE_SATELLITE_TILE_URL=https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_KEY
# VITE_SATELLITE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# API Configuration: the server address only. The code adds /api/v1/... itself
# (with /api/v1 here every request would go to /api/v1/api/v1/... and fail with 404).
VITE_API_BASE_URL=http://localhost:8000

# Environment
NODE_ENV=development

# Security Configuration
# Enable strict mode for additional checks
VITE_STRICT_MODE=true

# Enable error tracking in production (set to false for development)
VITE_ENABLE_ERROR_TRACKING=false

# Card form for the TEST payment mode only (use together with backend PAYMENT_TEST_MODE=True).
# Ignored in production builds. Real payments never take card numbers on this site.
VITE_PAYMENT_TEST_MODE=false
